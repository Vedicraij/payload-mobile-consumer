# Public, read-only Payload CMS used by the assessment application.
CMS_URL=https://payload-cms-poc-seven.vercel.app
WEBSITE_URL=https://payload-website-consumer.vercel.app
CMS_REQUEST_TIMEOUT_MS=10000
DEFAULT_MARKET=MX

# Analytics stays disabled for local development and candidate submissions.
# Mobile environment variables are bundled with the app and must never contain secrets.
ENABLE_ANALYTICS=false
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
